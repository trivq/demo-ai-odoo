<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================= -->
        <!-- ĐỊA ĐIỂM KHO BÃI HOÀNG PHÚC (STOCK LOCATIONS)                 -->
        <!-- ============================================================= -->

        <record id="location_kho_hai_phong" model="stock.location">
            <field name="name">Kho Cảng Đình Vũ (Hải Phòng - Xuất Khẩu)</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>

        <record id="location_kho_nghi_son" model="stock.location">
            <field name="name">Kho Nhà Máy Chế Biến Nghi Sơn (Thanh Hóa)</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>

        <record id="location_kho_lao_cai" model="stock.location">
            <field name="name">Kho Bãi Mỏ Lào Cai</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>

    </data>
</odoo>
